{$SITE_ADDRESS} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        -Server
    }
    @write not method GET HEAD
    respond @write "Read-only dashboard" 405
    reverse_proxy web:8765 {
        transport http {
            dial_timeout 5s
            response_header_timeout 30s
        }
    }
}
